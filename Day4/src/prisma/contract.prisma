// use prisma-8
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Tickets {
  id          Int           @id(map: "tickets_pkey") @default(autoincrement())
  title       String
  description String
  priority    String
  status      String
  assignee    String?
  createdAt   DateTime      @default(now()) @map("created_at")

  @@map("tickets")
}


